# --- Base de datos PostgreSQL ---
# Supabase: usa la cadena del "Session pooler" (Connect -> Session pooler).
# Formato: postgresql://postgres.<ref>:<PASSWORD>@aws-...pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.uirfpyjqrqluhpwoackf:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Fuerza SSL (Supabase lo requiere). Se autodetecta, pero lo dejamos explícito.
DB_SSL=true

# --- Servidor ---
PORT=4000
NODE_ENV=development
# En producción (Render): pon el dominio de Vercel para restringir CORS, ej.
# CORS_ORIGIN=https://frappe-tienda.vercel.app
# CORS_ORIGIN=

# --- Autenticación JWT ---
# Cambia esto por una cadena larga y aleatoria en producción
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Seed: admin inicial ---
# El script de seed crea el local y este usuario administrador
SEED_LOCAL_NOMBRE=Local Frappé
SEED_LOCAL_DIRECCION=Dirección del local
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_EMAIL=admin@frappe.local
SEED_ADMIN_PASSWORD=admin1234
