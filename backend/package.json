{
  "name": "frappe-backend",
  "version": "0.1.0",
  "description": "API de gestión para tienda de frappé — Fase 1: Base y accesos",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
